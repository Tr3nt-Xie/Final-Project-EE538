# Adds AddressSanitizer / UndefinedBehaviorSanitizer flags to an INTERFACE target.
function(aegis_apply_sanitizers target)
  set(san_flags "")
  if(AEGIS_ENABLE_ASAN)
    list(APPEND san_flags -fsanitize=address -fno-omit-frame-pointer)
  endif()
  if(AEGIS_ENABLE_UBSAN)
    list(APPEND san_flags -fsanitize=undefined)
  endif()
  if(san_flags)
    message(STATUS "AegisProxy: sanitizers enabled: ${san_flags}")
    target_compile_options(${target} INTERFACE ${san_flags})
    target_link_options(${target} INTERFACE ${san_flags})
  endif()
endfunction()
